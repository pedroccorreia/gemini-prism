# Customer & Identity Configuration
customer_id           = "example-customer"
customer_name         = "Example Customer"
environments          = ["non-prod", "prod"]
project_id_prefix     = ""
company_domain        = "example.com"
workspace_customer_id = "C01234567"
workspace_admin_email = "admin@example.com"

# Google Cloud Resource Hierarchy & Billing
billing_account = "0X1XXX-XXXXXX-XXXXXX"
billing_project = null # Optional: Project ID for API quota & billing overrides. Omit or set to null to use caller's default project.
folder_id       = null # Optional: GCP Folder ID. If omitted or null, projects are created directly at the root of the Organization.
org_id          = null # Optional: GCP Organization ID (used if folder_id is null/omitted).
sa_email        = null # Optional: Custom provisioner service account email. If omitted or null, active Application Default Credentials (ADC) are used.

# Discovery Engine & Workspace Connectors
location             = "global"
planned_connectors   = ["workspace"]
enable_connectors    = false
workspace_connectors = ["google_mail", "google_calendar", "google_drive", "google_chat"]

# Gemini Enterprise Assistant Customization
assistant_instructions = "You are an enterprise AI assistant helping employees find information across Google Workspace and internal knowledge bases. Provide accurate, helpful, and concise answers based on available enterprise data."

# Seat Allocations per Environment
seat_allocations = {
  prod     = 4
  non-prod = 1
}

# License Config details (set after billing account subscription is provisioned)
license_config_id = "00000000-0000-0000-0000-000000000000"
subscription_id   = "00000000-0000-0000-0000-000000000000"
subscription_tier = "Gemini Enterprise Standard"

# Atlassian Jira Connector (optional)
enable_jira_connector = false
jira_auth_type        = "OAUTH"

jira_config = {
  instance_uri        = "https://example.atlassian.net"
  instance_id         = "" # Jira Cloud ID UUID (fetch via: curl -s https://<site>.atlassian.net/_edge/tenant_info | jq -r .cloudId)
  data_source         = "jira"
  data_source_version = 3
  connector_modes     = ["FEDERATED"]
  refresh_interval    = "86400s"
  entities            = ["project", "issue", "attachment", "comment", "worklog"]
  static_ip_enabled   = false
  enable_actions      = false
  enabled_actions     = ["create_issue", "update_issue", "change_issue_status", "create_comment", "update_comment", "upload_attachment"]
}

# Note: Sensitive credentials should be passed via TF_VAR_jira_auth environment variable, e.g.:
# export TF_VAR_jira_auth='{"client_id":"...","client_secret":"...","instance_id":"..."}'  # for Jira Cloud OAUTH (v3, FEDERATED)
# or
# export TF_VAR_jira_auth='{"user_account":"user@example.com","api_token":"..."}'  # for Jira Server/Data Center BASIC_AUTH / API_TOKEN (v1)

# Atlassian Confluence Connector (optional)
enable_confluence_connector = false
confluence_auth_type        = "OAUTH"

confluence_config = {
  instance_uri        = "" # e.g. "https://example.atlassian.net" (defaults to jira_config.instance_uri if omitted)
  instance_id         = "" # Confluence Cloud ID UUID (defaults to jira_config.instance_id / TF_VAR_jira_auth if omitted)
  data_source         = "confluence"
  data_source_version = 4
  collection_id       = "confluence-federated-collection"
  connector_modes     = ["FEDERATED"]
  refresh_interval    = "86400s"
  entities            = ["space", "page", "blog", "attachment", "comment"]
  static_ip_enabled   = false
  enable_actions      = false
  enabled_actions     = ["create_page", "update_page", "create_blogpost", "create_space", "upload_attachment", "download_attachment"]
}

# Note: Sensitive credentials can be passed via TF_VAR_confluence_auth environment variable, e.g.:
# export TF_VAR_confluence_auth='{"client_id":"...","client_secret":"...","instance_id":"..."}'  # for Confluence Cloud OAUTH (v4, FEDERATED)
# If Confluence shares the same Atlassian tenant and 3LO app as Jira, omitting TF_VAR_confluence_auth will automatically fall back to TF_VAR_jira_auth.

# Google People & Org Directory Connector (optional)
enable_people_directory_connector = false

people_directory_config = {
  data_source             = "google_people_directory"
  collection_id           = "people-directory-collection"
  display_name            = "Google People Directory"
  include_suspended_users = false
  org_units_include       = [] # e.g. ["/Employees", "/Contractors"]
  custom_schemas_include  = [] # e.g. ["Skills", "Certifications"]
  refresh_interval        = "86400s"
  sync_mode               = "INCREMENTAL"
  entities                = ["user_profile", "job_architecture", "reporting_hierarchy", "location_contact", "custom_attributes"]
}

# HubSpot Connector (optional)
enable_hubspot_connector = false

hubspot_config = {
  instance_uri        = "https://api.hubapi.com"
  collection_id       = "hubspot-federated-collection"
  data_source         = "hubspot"
  connector_modes     = ["FEDERATED"]
  entities            = ["contacts", "companies", "deals", "tickets"]
  refresh_interval    = "86400s"
  static_ip_enabled   = false
  auto_run_disabled   = false
}

# Note: Sensitive credentials should be passed via TF_VAR_hubspot_auth environment variable, e.g.:
# export TF_VAR_hubspot_auth='{"oauth_access_token":"pat-na1-xxxx-xxxx"}'

